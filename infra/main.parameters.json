{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentParameters.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "environmentName": { "value": "${AZURE_ENV_NAME}" },
    "location": { "value": "${AZURE_LOCATION}" },
    "githubRepository": { "value": "${GITHUB_REPOSITORY=Azure/azure-functions-host}" },
    "foundryModel": { "value": "${FOUNDRY_MODEL=gpt-5-mini}" },
    "foundryModelName": { "value": "${FOUNDRY_MODEL_NAME=gpt-5-mini}" },
    "foundryModelVersion": { "value": "${FOUNDRY_MODEL_VERSION=2025-08-07}" },
    "foundryDeploymentCapacity": { "value": "${FOUNDRY_DEPLOYMENT_CAPACITY=50}" }
  }
}
